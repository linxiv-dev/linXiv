{
  "manifest_version": 3,
  "name": "linXiv Web Clipper",
  "version": "0.1.0",
  "description": "Clip academic papers from the browser into linXiv.",
  "host_permissions": [
    "https://arxiv.org/*",
    "https://www.arxiv.org/*"
  ],
  "action": {
    "default_title": "Clip to linXiv",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://arxiv.org/*",
        "https://www.arxiv.org/*"
      ],
      "js": [
        "assets/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}