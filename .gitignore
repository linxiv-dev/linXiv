# Environment
.env
.claude
.vscode
__pycache__/
*.py[cod]
assets/*.html
assets/*.*js
assets/*.sh
# Database
*.db

# arXiv rate-limit timestamp
.arxiv_ratelimit

# Downloaded files, create directories manually if this errors
pdfs/
source/

# Obsidian vault content (keep folder structure)
obsidian_vault/*
!obsidian_vault/.gitkeep

# Package reference docs (downloaded for offline use)
_package_docs/

# OS/Temp_files
.DS_Store
Thumbs.db
pyrightconfig.json
# docs: ignore all but the re-included paths below
# (see gitignore(5): un-ignore the dir, ignore its contents, then un-ignore paths)
docs/*
!docs/adr/
docs/adr/*
!docs/adr/**
!docs/cli_ref/
docs/cli_ref/*
!docs/cli_ref/**
!docs/api.md
!docs/architecture.md
!docs/build.md
!docs/headless/
docs/headless/*
!docs/headless/**
!docs/requirements.md
# Node / Frontend
node_modules/
dist/
dist-firefox/
.nvmrc

# Tauri build artifacts
src-tauri/target/
packaging/arch/pkg/
packaging/arch/src/
packaging/arch/*.pkg.tar.zst
packaging/arch/*.pkg.tar.zst.sig
# Sidecar binaries (all generated by build:sidecar; keep placeholder .gitkeep tracked)
src-tauri/binaries/linxiv-*
!src-tauri/binaries/.gitkeep

# Session state
user_settings.json
.venv
# env state
build/

# Regenerated by tauri-build on every build (capability-validation schemas +
# ACL snapshots); capabilities/default.json uses the hosted $schema instead.
src-tauri/gen/schemas/

# pdfium native lib (fetched per-host by scripts/fetch_pdfium.sh)
src-tauri/vendor/pdfium/

# local workflow scratch 
scratchpad-wf/
scratchpad-wf5/

